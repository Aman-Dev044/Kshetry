# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
.next-env.d.ts

# production
/build
/dist

# env files — .env.example is documentation and is committed
.env
.env.*
!.env.example

# vercel / netlify
.vercel
.netlify

# typescript
*.tsbuildinfo
next-env.d.ts

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# caches
.eslintcache
.turbo
.cache

# editors
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo

# os
.DS_Store
Thumbs.db
desktop.ini

# certificates and keys
*.pem
*.key
*.p12

# local scratch work — screenshots, extracted PDF text, one-off scripts
/scratch/
/shots/
*.local.*
