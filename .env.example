# Canonical origin. Drives canonical tags, Open Graph URLs, robots.txt and sitemap.xml.
NEXT_PUBLIC_SITE_URL=https://kshetryandco.com

# Where the contact, careers and newsletter forms deliver.
# Accepts any endpoint that takes a JSON POST — Formspree, Zapier, Make, n8n or an internal CRM.
# Until this is set, /api/enquiry replies 503 and the forms say so rather than silently failing.
ENQUIRY_WEBHOOK_URL=

# Port the frontend runs on. scripts/serve.mjs reads this and refuses to start
# anywhere else, so `npm run dev` / `npm start` are always on this port.
PORT=4142

# Interface to bind. 0.0.0.0 exposes the server on the machine's own IP, which
# is what you want when deploying; 127.0.0.1 keeps it reachable only locally.
HOST=0.0.0.0
